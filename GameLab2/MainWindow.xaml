<Window x:Class="GameLab2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GameLab2"
        mc:Ignorable="d"
        Title="GameLab2" Height="450" Width="800" Background="White">
    <Grid Margin="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель: характеристики игрока -->
        <Border Grid.Row="0" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="0,0,0,12">
            <UniformGrid Columns="3">
                <StackPanel HorizontalAlignment="Left">
                    <TextBlock Text="Gold" FontSize="12" Foreground="Gray"/>
                    <TextBlock x:Name="PlayerGold" FontSize="22" FontWeight="Bold"/>
                </StackPanel>

                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Damage" FontSize="12" Foreground="Gray"/>
                    <TextBlock x:Name="PlayerDamage" FontSize="22" FontWeight="Bold"/>
                </StackPanel>

                <StackPanel HorizontalAlignment="Right">
                    <TextBlock Text="Level" FontSize="12" Foreground="Gray"/>
                    <TextBlock x:Name="PlayerLevel" FontSize="22" FontWeight="Bold" HorizontalAlignment="Right"/>
                </StackPanel>
            </UniformGrid>
        </Border>

        <!-- Центр: враг (картинка слева, информация справа) -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button Click="DealDamage" Width="170" Height="170" Background="White" BorderBrush="Black" BorderThickness="1" ToolTip="Click to deal damage">
                <Image x:Name="EnemyImage" RenderOptions.BitmapScalingMode="NearestNeighbor" Stretch="Uniform" Margin="10"/>
            </Button>

            <StackPanel Width="260" Margin="30,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="EnemyName" FontSize="22" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,14"/>

                <TextBlock Text="Hit points" FontSize="12" Foreground="Gray"/>
                <TextBlock x:Name="EnemyHitPoint" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,8"/>

                <TextBlock Text="Gold reward" FontSize="12" Foreground="Gray"/>
                <TextBlock x:Name="GoldFromenemy" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"/>

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button Content="Repeat" Width="80" Height="30" Margin="0,0,10,0"/>
                    <Button Click="NextEnemy" Content="Next" Width="80" Height="30"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- Нижняя панель: улучшение -->
        <Border Grid.Row="2" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Padding="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Upgrade cost: " FontSize="14"/>
                    <TextBlock x:Name="UpgradeCost" FontSize="14" FontWeight="Bold"/>
                </StackPanel>

                <Button Click="UpgradeClick" Grid.Column="1" Content="Upgrade" Width="120" Height="36"/>
            </Grid>
        </Border>
    </Grid>
</Window>
